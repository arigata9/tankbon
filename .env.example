# Kopieren nach .env und anpassen
APP_PORT=3000

# Adresse, unter der das iPad den Server erreicht (für den Link zurück aus dem Kurzbefehl).
# Leer lassen = wird automatisch aus der Anfrage ermittelt.
PUBLIC_URL=

POSTGRES_USER=tankbon
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=tankbon

# Name des iOS-Kurzbefehls
SHORTCUT_NAME=Tankbon scannen

# Optionaler Passwortschutz (HTTP Basic Auth). Beide leer = kein Schutz.
AUTH_USER=
AUTH_PASSWORD=

# Optional: Spiegel auf einen zweiten PostgreSQL-Server (scripts/unraid-mirror.sh)
MIRROR_HOST=
MIRROR_PORT=5432
MIRROR_USER=tankbon
MIRROR_PASSWORD=
MIRROR_DB=tankbon
